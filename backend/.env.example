PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/winnerlens?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# OpenAI
OPENAI_API_KEY="your-openai-api-key"

# Coupang API
# Mock 모드 (개발용): true로 설정하면 실제 API 호출 없이 테스트 가능
USE_MOCK_COUPANG_API=true

# 실제 쿠팡 API 사용 시 아래 값들을 설정하세요
# 쿠팡 Wing 셀러센터에서 발급받을 수 있습니다
COUPANG_API_KEY="your-coupang-api-key"
COUPANG_API_SECRET="your-coupang-api-secret"
COUPANG_VENDOR_ID="your-vendor-id"

# AI Service
AI_SERVICE_URL="http://localhost:8000"

# Google Trends
# Mock 모드 (개발용): false로 설정하면 실제 Google Trends API 사용
USE_REAL_TRENDS=false

